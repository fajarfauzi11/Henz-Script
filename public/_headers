# Dibaca oleh Cloudflare static assets (disalin ke dist/ oleh build.js).
# Header yang cocok di beberapa aturan digabung; "! Nama" menghapus header dari aturan umum.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=300, must-revalidate

/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/data/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/fragment/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/pagefind/index/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
